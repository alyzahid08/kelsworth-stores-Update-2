# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to git.

# Postgres connection string. Your host (Railway/Render/etc.) gives you this
# after you create a Postgres database — copy it exactly as shown.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random long string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# The port the server listens on. Most hosts set this automatically —
# leave it as-is unless your host tells you otherwise.
PORT=3000

# Used once by `npm run seed` to create the first admin login.
# Change this password immediately after your first login.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Optional — order confirmation emails. If these are left blank, the store
# still works fine; it just skips sending the email and logs a note instead.
# Any SMTP provider works — a free option is Brevo (brevo.com): sign up,
# go to SMTP & API settings, and it gives you these values directly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Kelsworth <no-reply@yourdomain.com>

# Optional — where contact form submissions get emailed (in addition to
# always being saved in the database either way). Defaults to SMTP_USER if
# left blank.
CONTACT_TO_EMAIL=

# Optional — the domain used when generating /sitemap.xml URLs. Defaults to
# https://www.kelsworth.com if left blank; set this to your real domain.
SITE_ORIGIN=https://www.kelsworth.com

